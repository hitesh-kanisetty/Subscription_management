generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponTargetType {
  ALL
  FIRST_TIME
  SELECTED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum SupportCategory {
  PAYMENT
  SUBSCRIPTION
  ACCOUNT
  TECHNICAL
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id               Int          @id @default(autoincrement())
  name             String
  email            String       @unique
  password         String?
  authProvider     AuthProvider @default(LOCAL)
  roleId           Int
  twoFactorEnabled Boolean      @default(false)

  role           Role            @relation(fields: [roleId], references: [id])
  subscriptions  Subscription[]
  supportTickets SupportTicket[]
  ticketMessages TicketMessage[]
  notifications  Notification[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]
  couponUsages   CouponUsage[]
  twoFactorOtps  TwoFactorOtp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model TwoFactorOtp {
  id        Int      @id @default(autoincrement())
  userId    Int
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_otps")
}

model Plan {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  description   String?
  price         Decimal       @db.Decimal(10, 2)
  billingPeriod BillingPeriod @default(MONTHLY)
  features      String[]
  isActive      Boolean       @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id          Int                @id @default(autoincrement())
  userId      Int
  planId      Int
  status      SubscriptionStatus @default(ACTIVE)
  isTrial     Boolean            @default(false)
  startDate   DateTime           @default(now())
  renewalDate DateTime
  couponId    Int?

  renewal7DaySent Boolean @default(false)
  renewal3DaySent Boolean @default(false)
  renewalDaySent  Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  coupon Coupon? @relation(fields: [couponId], references: [id])

  payments     Payment[]
  couponUsages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([planId])
  @@map("subscriptions")
}

model Payment {
  id             Int      @id @default(autoincrement())
  subscriptionId Int
  amount         Decimal  @db.Decimal(10, 2)
  status         String   @default("PAID")
  paymentMethod  String   @default("DEMO")
  transactionId  String   @unique
  paymentDate    DateTime @default(now())
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  supportTickets SupportTicket[]

  @@index([subscriptionId])
  @@map("payments")
}

model SupportTicket {
  id Int @id @default(autoincrement())

  userId    Int
  paymentId Int?

  category    SupportCategory
  subject     String
  description String
  status      SupportStatus   @default(OPEN)

  user    User     @relation(fields: [userId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([paymentId])
  @@index([status])
  @@map("support_tickets")
}

model TicketMessage {
  id       Int    @id @default(autoincrement())
  ticketId Int
  senderId Int
  message  String

  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  sender User          @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([senderId])
  @@map("ticket_messages")
}

model Notification {
  id     Int @id @default(autoincrement())
  userId Int

  type    String
  title   String
  message String
  details Json?
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_resets")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String
  module      String
  description String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Coupon {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String?

  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(10, 2)

  validFrom  DateTime
  validUntil DateTime

  usageLimit Int?
  usedCount  Int  @default(0)

  minimumAmount Decimal? @db.Decimal(10, 2)

  targetType CouponTargetType @default(ALL)

  isActive Boolean @default(true)

  usages        CouponUsage[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model CouponUsage {
  id Int @id @default(autoincrement())

  couponId       Int
  userId         Int
  subscriptionId Int?

  discountAmount Decimal @db.Decimal(10, 2)

  usedAt DateTime @default(now())

  coupon       Coupon        @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@index([subscriptionId])
  @@map("coupon_usages")
}
